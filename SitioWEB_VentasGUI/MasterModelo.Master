<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterModelo.master.cs" Inherits="DemoWEB_AJAX.MasterModelo" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> SISTEMA VENTAS</title>
     <%--Referencia a la hoja de estilos  de la carpeta CSS--%>
 <link href="CSS/DemoCSS.css" rel="stylesheet" type="text/css" />
     <%--Referencia a BootStrap--%>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #007bff; /* Azul vibrante */
            --secondary-color: #6c757d; /* Gris para contraste */
            --dark-background: #2c3e50; /* Azul oscuro para fondos */
            --light-text: #ecf0f1; /* Gris claro para textos sobre fondos oscuros */
            --accent-color: #28a745; /* Verde para acentos o éxito */
            --header-bg: #34495e; /* Un gris azulado oscuro para el header */
        }

        body {
            font-family: 'Open Sans', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: #f4f7f6; /* Un fondo general ligeramente gris */
            color: #333; /* Color de texto base */
        }

        .navbar {
            background-color: var(--header-bg) !important; /* Fondo del navbar */
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2); /* Sombra más pronunciada */
            padding-top: 1rem;
            padding-bottom: 1rem;
        }

        .navbar-brand {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            color: var(--light-text) !important; /* Texto del logo blanco/claro */
            font-size: 1.8rem;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
        }

        .navbar-nav .nav-link {
            color: var(--light-text) !important; /* Texto de los enlaces del navbar */
            font-weight: 600;
            margin-right: 15px;
            transition: color 0.3s ease, background-color 0.3s ease;
            padding: 10px 15px;
            border-radius: 5px;
        }

        .navbar-nav .nav-link:hover,
        .navbar-nav .nav-link.active {
            color: var(--accent-color) !important; /* Verde para hover y activo */
            background-color: rgba(255, 255, 255, 0.1);
        }

        .dropdown-menu {
            background-color: var(--dark-background); /* Fondo oscuro para el dropdown */
            border: none;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
        }

        .dropdown-item {
            color: var(--light-text) !important; /* Texto de los items del dropdown */
            transition: background-color 0.3s ease;
        }

        .dropdown-item:hover {
            background-color: var(--primary-color) !important; /* Fondo del item en hover */
            color: #fff !important; /* Texto blanco en hover */
        }

        .dropdown-divider {
            border-top: 1px solid rgba(255, 255, 255, 0.1); /* Separador más sutil */
        }

        .content-wrapper {
            flex: 1;
            padding: 30px 0;
            background-color: #ffffff; /* Contenido principal blanco */
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.05); /* Sombra suave para el contenedor */
            margin-top: 20px;
            margin-bottom: 20px;
        }

        footer {
            background-color: var(--header-bg); /* Fondo del footer igual al header */
            padding: 25px 0;
            text-align: center;
            color: var(--light-text); /* Texto del footer claro */
            border-top: 1px solid var(--dark-background);
            box-shadow: 0 -2px 4px rgba(0,0,0,.1);
        }
    </style>

    <asp:ContentPlaceHolder ID="Cabecera" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form runat="server">
        <header>
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container-fluid">
                    <a class="navbar-brand" runat="server" href="~/">
                        <i class="fas fa-rocket me-2"></i> SISTEMA DE VENTAS- MODULO CONSULTAS Y TRANSACCIONES
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link active" aria-current="page" runat="server" href="~/Default.aspx">INICIO</a>
                            </li>                          
                            
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownConsultas" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-sliders-h me-1"></i> CONSULTAS
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="navbarDropdownConfiguracion">
                                    <li><a class="dropdown-item" runat="server" href="~/Consultas/WebFacturacionCliente.aspx">Facturacion clientes</a></li>
                                     <li><a class="dropdown-item" runat="server" href="~/Consultas/WebFacturacionVendedor.aspx">Facturacion vendedores</a></li>
                                    <li><a class="dropdown-item" runat="server" href="~/Consultas/WebFacturacionPaginada.aspx">Facturacion paginada</a></li>
                                    <li><a class="dropdown-item" runat="server" href="~/Consultas/WebGraficosFacturacion.aspx">Estadistica ventas</a></li>
                                  </ul>                              
                             </li>
                           <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownTransacciones" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-sliders-h me-1"></i> TRANSACCIONES
                         </a>
                        <ul class="dropdown-menu" aria-labelledby="navbarDropdownConfiguracion">
                        <li><a class="dropdown-item" runat="server" href="~/Transacciones/RegistrarOrden.aspx">Registrar Orden</a></li>
                        <li><a class="dropdown-item" runat="server" href="~/Transacciones/ListarOrdenes.aspx">Aprobar Ordenes</a></li>
                        </ul>                              
                    </li>
                             <li class="nav-item">
                                              <a class="nav-link" aria-current="page" runat="server" href="~/Logout.aspx">CERRAR SESION</a>
                             </li>    

                        </ul>
                      
                    </div>
                </div>
            </nav>
        </header>
            <%--Para facilitar el empleo de AJAX dentro de los formularios hijos del Masterpage--%>
<asp:ScriptManager ID="ScriptManager1" runat="server" EnableScriptGlobalization="True"></asp:ScriptManager>
        <div class="container content-wrapper">
            <asp:ContentPlaceHolder ID="Principal" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <footer class="mt-auto">
            <div class="container">
                <asp:Label ID="lblUsuario" runat="server" CssClass="labelContenido"></asp:Label>
                <p>&copy; <%: DateTime.Now.Year  %> Elaborado por : Jose Leon Cabel - ISIL </p>
                
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <script src="https://kit.fontawesome.com/your-font-awesome-kit.js" crossorigin="anonymous"></script>
    </form>
       <%--FUNCION EN JAVA SCRIPT PARA LA EXPIRACION DE LA SESION--%>
<script type="text/javascript">
        // Tiempo de inactividad en milisegundos (60 segundos =60000 ms)
        const tiempoInactividad = 60000; 
        let temporizador;

        function ReiniciarTemporizador() {
            // Limpiamos el temporizador anterior cada vez que el usuario hace algo
            clearTimeout(temporizador);
            
            // Iniciamos la cuenta regresiva de 55 segundos
            temporizador = setTimeout(CerrarSesionPorInactividad, tiempoInactividad);
        }

        function CerrarSesionPorInactividad() {
           // Redirige al archivo Logout.aspx 
            window.location.href = '<%= ResolveUrl("~/Logout.aspx") %>';
        }

        // Escuchamos los movimientos del usuario para saber si está activo en la página
        window.onload = ReiniciarTemporizador;
        window.onmousemove = ReiniciarTemporizador;
        window.onkeypress = ReiniciarTemporizador;
        window.onclick = ReiniciarTemporizador;
        window.onscroll = ReiniciarTemporizador;

        // SOPORTE PARA AJAX / POSTBACKS:
        // Si usas UpdatePanel o llamadas asíncronas de ASP.NET, esto reiniciará el JS
        if (typeof (Sys) !== 'undefined') {
            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(IniciarTemporizadorSeguro);
        }
</script>  
</body>
</html>
